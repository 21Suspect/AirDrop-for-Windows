<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AirDrop for Windows"
 Width="820" Height="610" MinWidth="780" MinHeight="590" WindowStartupLocation="CenterScreen"
 Background="#FCFCFD" FontFamily="Segoe UI" FontSize="14" Foreground="#202124">
 <Window.Resources>
  <SolidColorBrush x:Key="Blue" Color="#007AFF"/>
  <Style TargetType="Button">
   <Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="14,8"/>
   <Setter Property="Background" Value="#ECEEF2"/><Setter Property="Foreground" Value="#33363D"/>
   <Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="Medium"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.78"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.6"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.35"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#007AFF"/><Setter TargetName="Chrome" Property="BorderThickness" Value="1"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{StaticResource Blue}"/><Setter Property="Foreground" Value="White"/></Style>
  <Style x:Key="Quiet" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#70757D"/></Style>
  <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="#80858D"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="11,8"/><Setter Property="BorderBrush" Value="#DFE2E7"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="White"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="ListBoxItem">
   <Setter Property="Margin" Value="7,0"/><Setter Property="Padding" Value="12"/>
   <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Width" Value="190"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Border x:Name="Peer" CornerRadius="16" Padding="{TemplateBinding Padding}" Background="Transparent">
     <ContentPresenter HorizontalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Peer" Property="Background" Value="#EAF3FF"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Peer" Property="BorderBrush" Value="#D9E9FF"/><Setter TargetName="Peer" Property="BorderThickness" Value="1"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid Margin="28,20,28,15">
  <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel>
    <TextBlock Name="SidebarName" Text="This PC" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
    <StackPanel Orientation="Horizontal" Margin="0,5,0,0"><Ellipse Name="StatusDot" Fill="#A6ABB2" Width="6" Height="6" Margin="0,0,6,0"/><TextBlock Name="StatusBadge" Text="Offline" FontSize="12" Foreground="#80858D"/></StackPanel>
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
    <Button Name="NavAirDrop" Content="Back" Style="{StaticResource Quiet}" Visibility="Collapsed" Margin="0,0,6,0"/>
    <Button Name="NavHistory" Content="Recent" Style="{StaticResource Quiet}" Margin="0,0,4,0"/>
    <Button Name="NavSettings" Content="Settings" Style="{StaticResource Quiet}" Margin="0,0,10,0"/>
    <Button Name="ToggleRadio" Content="Turn on" Style="{StaticResource Primary}" MinWidth="92"/>
   </StackPanel>
  </Grid>
  <Grid Grid.Row="1">
   <StackPanel Name="AirDropPage">
    <Grid Height="244">
     <StackPanel Name="EmptyScene" VerticalAlignment="Center" HorizontalAlignment="Center">
      <Grid Width="102" Height="102" Margin="0,0,0,15">
       <Ellipse Stroke="#EBEEF3" StrokeThickness="1"/><Ellipse Width="76" Height="76" Stroke="#E0E7F1" StrokeThickness="1"/>
       <Ellipse Width="50" Height="50" Fill="#007AFF"/>
       <Path Data="M 0,10 L 10,0 L 20,10 M 10,0 L 10,25" Stroke="White" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="20" Height="25"/>
      </Grid>
      <TextBlock Name="HeroTitle" Text="Ready to share" FontSize="21" FontWeight="SemiBold" TextAlignment="Center"/>
      <TextBlock Name="HeroDescription" Text="Turn on to find nearby devices." Style="{StaticResource Muted}" TextAlignment="Center" Margin="0,7,0,0" MaxWidth="590" MaxHeight="42"/>
     </StackPanel>
     <ListBox Name="Devices" BorderThickness="0" Background="Transparent" HorizontalAlignment="Center"
       VerticalAlignment="Center" Visibility="Collapsed" AutomationProperties.Name="Nearby devices">
      <ListBox.Template><ControlTemplate TargetType="ListBox"><ItemsPresenter HorizontalAlignment="Center"/></ControlTemplate></ListBox.Template>
      <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
      <ListBox.ItemTemplate><DataTemplate>
       <StackPanel Width="158">
        <Border Width="66" Height="66" CornerRadius="33" Background="White" HorizontalAlignment="Center" Margin="0,0,0,13">
         <TextBlock Text="&#xE8EA;" FontFamily="Segoe MDL2 Assets" FontSize="29" Foreground="#007AFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock Text="{Binding Name}" TextAlignment="Center" TextWrapping="Wrap" MaxHeight="43" FontWeight="Medium"/>
       </StackPanel>
      </DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <StackPanel Name="DevicePaging" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Visibility="Collapsed">
      <Button Name="DevicesPrevious" Content="‹" Style="{StaticResource Quiet}" Padding="12,3" AutomationProperties.Name="Previous devices"/>
      <TextBlock Name="DevicePageNumber" Text="1 / 1" FontSize="11" Foreground="#9399A2" VerticalAlignment="Center"/>
      <Button Name="DevicesNext" Content="›" Style="{StaticResource Quiet}" Padding="12,3" AutomationProperties.Name="Next devices"/>
     </StackPanel>
    </Grid>
    <Border Name="DropZone" AllowDrop="True" Background="#F1F3F6" CornerRadius="13" Padding="16,14" Margin="0,10,0,0">
     <DockPanel>
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="15,0,0,0">
       <Button Name="ChooseFiles" Content="Choose files…" Background="White" Margin="0,0,8,0"/>
       <Button Name="SendFiles" Content="Send" Style="{StaticResource Primary}" IsEnabled="False" MinWidth="68"/>
      </StackPanel>
      <StackPanel VerticalAlignment="Center">
       <TextBlock Name="FileSummary" Text="Drop files to send" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
       <TextBlock Name="FileSize" Text="Or choose a file from your PC." FontSize="12" Foreground="#8B919A" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
     </DockPanel>
    </Border>
    <Border Name="TransferCard" Margin="1,16,1,0" Visibility="Hidden" Height="62">
     <StackPanel>
      <DockPanel><Button Name="CancelTransfer" DockPanel.Dock="Right" Content="Cancel" Style="{StaticResource Quiet}" Padding="10,2"/><TextBlock Name="TransferTitle" Text="Receiving…" FontSize="12" FontWeight="Medium" TextTrimming="CharacterEllipsis"/></DockPanel>
      <ProgressBar Name="TransferProgress" Height="3" Margin="0,8,0,7" Foreground="#007AFF"/>
      <TextBlock Name="TransferDetail" FontSize="11" Foreground="#8B919A" TextTrimming="CharacterEllipsis"/>
     </StackPanel>
    </Border>
   </StackPanel>
   <StackPanel Name="HistoryPage" Visibility="Collapsed">
    <TextBlock Name="PageTitle" Text="Recent transfers" FontSize="21" FontWeight="SemiBold" Margin="0,10,0,20"/>
    <StackPanel Name="HistoryItems" Height="300"/>
    <StackPanel Name="HistoryPaging" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
     <Button Name="HistoryPrevious" Content="‹ Previous" Style="{StaticResource Quiet}"/>
     <TextBlock Name="HistoryPageNumber" Text="1 / 1" FontSize="12" Foreground="#8B919A" VerticalAlignment="Center" Margin="10,0"/>
     <Button Name="HistoryNext" Content="Next ›" Style="{StaticResource Quiet}"/>
    </StackPanel>
   </StackPanel>
   <StackPanel Name="SettingsPage" Visibility="Collapsed">
    <TextBlock Text="Settings" FontSize="21" FontWeight="SemiBold" Margin="0,10,0,17"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="145"/></Grid.ColumnDefinitions>
     <StackPanel><Label Target="{Binding ElementName=DeviceName}" Content="Device name" Padding="0,0,0,6" FontSize="12"/><TextBox Name="DeviceName" MaxLength="63"/></StackPanel>
     <StackPanel Grid.Column="2"><Label Target="{Binding ElementName=SizeLimit}" Content="Transfer limit" Padding="0,0,0,6" FontSize="12"/><ComboBox Name="SizeLimit" Padding="10,8" MaxDropDownHeight="130"><ComboBoxItem Content="1 GB"/><ComboBoxItem Content="4 GB"/><ComboBoxItem Content="8 GB"/></ComboBox></StackPanel>
    </Grid>
    <Label Target="{Binding ElementName=ReceiveFolder}" Content="Receive folder" Padding="0,16,0,6" FontSize="12"/>
    <DockPanel><Button Name="BrowseFolder" Content="Browse…" DockPanel.Dock="Right" Margin="8,0,0,0"/><TextBox Name="ReceiveFolder"/></DockPanel>
    <CheckBox Name="AskBeforeReceiving" Content="Ask before receiving" Margin="0,23,0,0" Padding="6,0" FontSize="14"/>
    <TextBlock Text="When off, files from anyone nearby are saved automatically." Style="{StaticResource Muted}" FontSize="12" Margin="23,6,0,0"/>
    <DockPanel Margin="0,22,0,0"><Button Name="SaveSettings" Content="Save" Style="{StaticResource Primary}" HorizontalAlignment="Left" DockPanel.Dock="Left" MinWidth="80"/><TextBlock Text="Turn off AirDrop to change its name, folder or limit." Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="14,0,0,0" FontSize="12"/></DockPanel>
    <Border BorderBrush="#E8EBF0" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,21,0,0">
     <DockPanel><Button Name="OpenDiagnostics" Content="Diagnostics" Style="{StaticResource Quiet}" DockPanel.Dock="Right" Padding="10,5"/><Button Name="RestoreRadio" Content="Restore Wi-Fi" DockPanel.Dock="Right" Visibility="Collapsed" Padding="10,5"/><TextBlock Text="Preview · Test Mode required&#x0a;Wi-Fi is reserved for AirDrop while enabled." FontSize="11" Foreground="#9197A0" VerticalAlignment="Center"/></DockPanel>
    </Border>
   </StackPanel>
  </Grid>
  <DockPanel Grid.Row="2">
   <Button Name="OpenReceiveFolder" Content="Open folder ↗" Style="{StaticResource Quiet}" DockPanel.Dock="Right" Padding="0,4" FontSize="12"/>
   <TextBlock Name="Footer" Text="Receive from everyone" FontSize="12" Foreground="#9298A0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,15,0"/>
  </DockPanel>
  <Border Name="OfferOverlay" Grid.RowSpan="3" Background="#D9FCFCFD" Visibility="Collapsed">
   <Border Background="White" CornerRadius="18" BorderBrush="#E5E8EF" BorderThickness="1" Width="420" Padding="27" HorizontalAlignment="Center" VerticalAlignment="Center">
    <StackPanel><TextBlock Text="Incoming AirDrop" FontSize="23" FontWeight="SemiBold"/>
     <TextBlock Name="OfferSender" FontSize="15" Margin="0,16,0,7" TextWrapping="Wrap" MaxHeight="42"/>
     <TextBlock Name="OfferFiles" Style="{StaticResource Muted}" MaxHeight="72" Margin="0,0,0,12"/>
     <TextBlock Text="Accept only a transfer you expect." Style="{StaticResource Muted}" FontSize="12"/>
     <TextBlock Name="OfferCountdown" Style="{StaticResource Muted}" FontSize="12" Margin="0,12,0,17"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions><Button Name="DeclineOffer" Content="Decline"/><Button Name="AcceptOffer" Grid.Column="2" Content="Accept" Style="{StaticResource Primary}"/></Grid>
    </StackPanel>
   </Border>
  </Border>
 </Grid>
</Window>
